# Copy to .env. Never send credential values through MCP or chat.
DSP_MOCK_MODE=false
DSP_CLI_ENTRY=.tools/node_modules/@sap/datasphere-cli/terminal.js
DSP_NODE_EXECUTABLE=node
DSP_OPERATION_TIMEOUT=120
DSP_CLI_TIMEOUT=60
DSP_MAX_RESPONSE_BYTES=26214400

# User-based OAuth (Interactive Usage). Use HTTPS URLs supplied by your admin.
DSP_DEV_BASE_URL=
DSP_DEV_AUTH_MODE=refresh_token
DSP_DEV_TOKEN_URL=
DSP_DEV_CLIENT_ID=
DSP_DEV_CLIENT_SECRET=
DSP_DEV_REFRESH_TOKEN=
# Alternative: locally exported SAP CLI OAuth session; see README.
DSP_DEV_SECRETS_FILE=.secrets/dev.json
DSP_DEV_SPACES_BACKEND=cli

DSP_DEV_ALLOW_EXECUTE=true
DSP_DEV_ALLOW_WRITE=true
DSP_DEV_ALLOW_DELETE=true

DSP_QAS_BASE_URL=
DSP_QAS_TOKEN_URL=
DSP_QAS_CLIENT_ID=
DSP_QAS_CLIENT_SECRET=
DSP_QAS_REFRESH_TOKEN=
# Alternative: locally exported SAP CLI OAuth session; see README.
DSP_QAS_SECRETS_FILE=.secrets/qas.json
DSP_QAS_SPACES_BACKEND=cli

DSP_QAS_ALLOW_EXECUTE=true
DSP_QAS_ALLOW_WRITE=true
DSP_QAS_ALLOW_DELETE=false

DSP_PRD_BASE_URL=
DSP_PRD_TOKEN_URL=
DSP_PRD_CLIENT_ID=
DSP_PRD_CLIENT_SECRET=
DSP_PRD_REFRESH_TOKEN=
# Alternative: locally exported SAP CLI OAuth session; see README.
DSP_PRD_SECRETS_FILE=.secrets/prd.json
DSP_PRD_SPACES_BACKEND=cli

DSP_PRD_ALLOW_EXECUTE=false
DSP_PRD_ALLOW_WRITE=false
DSP_PRD_ALLOW_DELETE=false

# Explicitly opt in to DEV smoke test after configuring OAuth.
DSP_RUN_DEV_INTEGRATION=false
DSP_TEST_SPACE=BSG_BI
DSP_TEST_OBJECT_TYPE=local-tables
DSP_TEST_TECHNICAL_NAME=T_TEST
DSP_DEV_ALLOW_WRITE=true